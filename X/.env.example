# Copy this file to X/.env and fill values locally. Never commit real credentials.

X_API_KEY=replace_with_api_key
X_API_KEY_SECRET=replace_with_api_key_secret
X_ACCESS_TOKEN=replace_with_access_token
X_ACCESS_TOKEN_SECRET=replace_with_access_token_secret
X_BEARER_TOKEN=replace_with_bearer_token
X_CLIENT_ID=replace_with_client_id
X_CLIENT_SECRET=replace_with_client_secret
X_CALLBACK_URL=http://127.0.0.1:8765/callback
